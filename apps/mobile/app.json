{
  "expo": {
    "name": "Stories",
    "slug": "stories",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/stories-icon.png",
    "scheme": "stories",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rahulm.stories",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EA",
        "foregroundImage": "./assets/images/stories-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/stories-adaptive-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "816b91c2-c913-4267-840b-58bb34f6f6bb"
      }
    }
  }
}
